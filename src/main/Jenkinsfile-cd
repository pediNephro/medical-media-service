pipeline {
    agent any

    environment {
        IMAGE_NAME = "alaadid/medical-media-service"
    }

    stages {

        stage('Pull Image') {
            steps {
                sh 'docker pull $IMAGE_NAME:latest'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh '''
                docker stop medical-media || true
                docker rm medical-media || true
                '''
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker run -d -p 8086:8086 --name medical-media $IMAGE_NAME:latest
                '''
            }
        }
    }
}
