pipeline {

    agent any

    stages {

        stage('Deploy To Kubernetes') {

            steps {

                sh '''
                kubectl apply -f medical-media.yaml --validate=false
                '''
            }
        }

        stage('Verify Deployment') {

            steps {

                sh '''
                kubectl rollout status deployment/medical-media -n pedinephro

                kubectl get pods -n pedinephro
                '''
            }
        }
    }
}
