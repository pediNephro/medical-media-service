pipeline {

    agent any

    environment {
        IMAGE_NAME = "alaadid/medical-media-service"
    }

    stages {

        stage('Pull Image') {

            steps {
                sh 'docker pull $IMAGE_NAME:latest'
            }
        }

        stage('Create Network') {

            steps {
                sh 'docker network create my-network || true'
            }
        }

        stage('Start MySQL') {

            steps {

                sh '''
                docker rm -f mysql || true

                docker run -d \
                --name mysql \
                --network my-network \
                -e MYSQL_ROOT_PASSWORD=root \
                -e MYSQL_DATABASE=nephro_medical_media \
                mysql:8
                '''
            }
        }

        stage('Wait for MySQL') {

            steps {
                sh 'sleep 25'
            }
        }

        stage('Run Medical Media') {

            steps {

                sh '''
                docker rm -f medical-media || true

                docker run -d \
                --name medical-media \
                --network my-network \
                -p 8086:8086 \
                $IMAGE_NAME:latest
                '''
            }
        }

        stage('Deploy To Kubernetes') {

            steps {

                sh '''
                kubectl apply -f medical-media.yaml --validate=false || true
                '''
            }
        }

        stage('Verify Deployment') {

            steps {

                sh '''
                kubectl get pods -n pedinephro || true
                '''
            }
        }
    }
}
